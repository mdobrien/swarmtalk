{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [{ "type": "command", "command": "\"__MM__\" session start", "timeout": 15 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "\"__MM__\" session end", "timeout": 15 }]
      }
    ]
  }
}
